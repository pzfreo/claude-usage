{
  "manifest_version": 3,
  "name": "Claude Usage",
  "version": "1.0",
  "description": "Shows Claude plan usage limits at a glance",
  "permissions": ["cookies", "alarms", "storage", "nativeMessaging"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://claude.ai/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Usage",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  }
}
